# ==============================================================================
# PUNE YOGA STUDIO & CAFÉ PLATFORM - ENVIRONMENT CONFIGURATION
# All keys must be owned by the CLIENT for deployment handover.
# ==============================================================================

# Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (PostgreSQL & Auth)
# Client's own Supabase project: Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Razorpay Payment Gateway (Client Account)
# Dashboard -> Settings -> API Keys & Webhooks
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_yourkey
RAZORPAY_KEY_SECRET=your_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# Transactional Email (Custom SMTP on Verified Client Domain)
# Domain must have valid SPF, DKIM, DMARC records
SMTP_HOST=smtp.yourdomain.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=notifications@yourdomain.com
SMTP_PASSWORD=your_smtp_app_password
SMTP_FROM_EMAIL=hello@yourdomain.com
SMTP_FROM_NAME="THE AM:PM STUDIO"

# Meta WhatsApp Cloud API (Milestone Add-on)
# Meta Business Suite -> WhatsApp Cloud API
WHATSAPP_API_TOKEN=your_meta_system_user_token
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id
WHATSAPP_BUSINESS_ACCOUNT_ID=your_waba_id
WHATSAPP_WEBHOOK_VERIFY_TOKEN=your_custom_webhook_secret

# Security & Sessions
CRON_SECRET=generate-random-32-char-secret-for-scheduled-jobs
